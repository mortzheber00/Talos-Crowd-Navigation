// For format details, see https://aka.ms/devcontainer.json.
{
	"name": "ROS jazzy",
	"image": "tum-ics-ros:jazzy-legged-robotics-devel-vscode",

	"containerEnv" : {
		"CONT_PWD" : "${containerWorkspaceFolder}",
		"DISPLAY" : "${localEnv:DISPLAY}",
		"QT_X11_NO_MITSHM" : "1",
		"XAUTHORITY": "/home/devel/.Xauthority"
	},

	"remoteUser": "devel",

	"remoteEnv": { 
		"DISPLAY": "${localEnv:DISPLAY}" 
	},

	"postCreateCommand": "pip3 install --break-system-packages drake",

	"runArgs": [
		"--name", "${containerWorkspaceFolderBasename}_devcont",
		"--hostname", "${containerWorkspaceFolderBasename}_devcont",
		"--add-host=${containerWorkspaceFolderBasename}_devcont=127.0.1.2",
		"--privileged",
     	"--net=host" 
	],

	"mounts": [
		{ 
			"source": "/dev/dri", 
			"target": "/dev/dri",
			"type": "bind"
		},
		{ 
			"source": "/tmp/.X11-unix", 
			"target": "/tmp/.X11-unix",
			"type": "bind"
		},
		{ 
			"source": "/dev", 
			"target": "/dev",
			"type": "bind"
		}
	],

	"customizations": {
		"vscode": {
			"extensions": [
				"ms-vscode.cpptools",
				"ms-vscode.cpptools-extension-pack",
				"cschlosser.doxdocgen",
				"shd101wyy.markdown-preview-enhanced"
			],
			"settings": {
				"remote.autoForwardPorts": false
			}
		}
	}
}
