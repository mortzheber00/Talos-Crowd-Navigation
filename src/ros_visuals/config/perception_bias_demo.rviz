Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /TF1
        - /GroundTruth1
        - /CentroidGroundTruth1
        - /SurfacePoints1
        - /CentroidRaw1
        - /CentroidCorrected1
        - /CorrectionVector1
      Splitter Ratio: 0.5
    Tree Height: 0
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Plane: XY
      Plane Cell Count: 10
      Cell Size: 1
      Color: 160; 160; 160
      Line Style:
        Value: Lines
        Line Width: 0.03
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Alpha: 0.8
      Show Visual Geometry: true
      Show Collision Geometry: false
      General Opacity: 0.8
      Description Topic: /robot_description
      Links:
        All Links Enabled: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Frame Timeout: 15
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Marker Scale: 1
      Frames:
        All Enabled: true
    - Class: rviz_default_plugins/PointCloud2
      Name: PointCloud2
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /camera/depth/points
      Use Transient Local: false
      Selectable: true
      Queue Size: 10
      Color Transformer: ""
      Value: true
      Style:
        Decay Time: 0
        Point Shape: Sphere
        Point Size: 0.05
        Unselectable Transparency: 0.5
    # Front-surface-bias demo markers (perception_bias_demo.py), each its own
    # Marker display so it gets an independent on/off checkbox for the talk.
    - Class: rviz_default_plugins/Marker
      Name: GroundTruth
      Enabled: true
      Topic: /perception_bias_demo/ground_truth
      Queue Size: 100
      Namespaces: {}
    - Class: rviz_default_plugins/Marker
      Name: CentroidGroundTruth
      Enabled: true
      Topic: /perception_bias_demo/centroid_ground_truth
      Queue Size: 100
      Namespaces: {}
    - Class: rviz_default_plugins/Marker
      Name: SurfacePoints
      Enabled: true
      Topic: /perception_bias_demo/surface_points
      Queue Size: 100
      Namespaces: {}
    - Class: rviz_default_plugins/Marker
      Name: CentroidRaw
      Enabled: true
      Topic: /perception_bias_demo/centroid_raw
      Queue Size: 100
      Namespaces: {}
    - Class: rviz_default_plugins/Marker
      Name: CentroidCorrected
      Enabled: true
      Topic: /perception_bias_demo/centroid_corrected
      Queue Size: 100
      Namespaces: {}
    - Class: rviz_default_plugins/Marker
      Name: CorrectionVector
      Enabled: true
      Topic: /perception_bias_demo/correction_vector
      Queue Size: 100
      Namespaces: {}
  Enabled: true
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
    - Class: rviz_default_plugins/SetGoal
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 5.0
      Enable Stereo Rendering: false
      Focal Point:
        X: 1.5
        Y: 0
        Z: 0.5
      Pitch: 0.35
      Yaw: 0.785398
    Saved: ~
